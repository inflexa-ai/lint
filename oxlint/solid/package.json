{
  "name": "@inflexa-ai/oxlint-plugin-solid",
  "version": "0.7.0",
  "description": "The oxlint rules and configuration of Inflexa for SolidJS applications.",
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "solid",
    "solidjs",
    "typescript"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inflexa-ai/lint.git",
    "directory": "oxlint/solid"
  },
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "source": "./src/js-plugin.ts",
      "types": "./dist/js-plugin.d.ts",
      "default": "./dist/js-plugin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json --removeComments --declaration false && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "prepublishOnly": "echo \"Publish through scripts/release.mjs at the root of the workspace, which stages a clean package.\" && exit 1",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": ">=7.0.2003"
  },
  "dependencies": {
    "@inflexa-ai/oxlint-plugin": "^0.7.0",
    "@oxlint/plugins": "^1.85.0",
    "eslint-plugin-solid": "^0.18.1"
  }
}
