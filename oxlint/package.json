{
  "name": "@inflexa-ai/oxlint-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "typecheck",
    "typescript",
    "react",
    "solid"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces",
    "lint": "npm run lint:oxlint && npm run lint:typecheck && npm run lint:directives && npm run lint:jscpd",
    "lint:oxlint": "NODE_OPTIONS=--conditions=source oxlint",
    "lint:typecheck": "node --conditions=source typecheck/src/cli.ts -p typecheck -p typescript -p react -p solid -p .",
    "lint:directives": "node --conditions=source typescript/src/directives/cli.ts --ignore \"typescript/src/directives/test/**\" .",
    "lint:jscpd": "jscpd",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "jscpd": "5.3.3",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  }
}
