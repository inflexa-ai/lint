{
  // The project that the typed rule tests check their cases against. `include`
  // names the modules that a case imports and no case file, thus a case belongs
  // to no project and the parser's `allowDefaultProject` gives it one.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "types": []
  },
  "include": ["query-clients.ts"]
}
