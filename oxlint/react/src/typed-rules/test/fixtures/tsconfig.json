{
  // The project that the typed rule tests check their cases against. `include`
  // names the modules that a case imports and the file names of the cases,
  // which the rule tester serves through the file system of the API.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "types": []
  },
  "include": ["*.ts", "*.tsx"]
}
